{
  "manifest_version": 3,
  "name": "ToBe 浏览器连接",
  "version": "1.6.13",
  "description": "让 ToBe 使用当前浏览器已登录的竞赛平台提交代码并接收评测结果。",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://codeforces.com/*",
    "https://www.codeforces.com/*",
    "https://atcoder.jp/*",
    "https://ac.nowcoder.com/*",
    "https://www.nowcoder.com/*",
    "https://nowcoder.com/*",
    "https://www.luogu.com.cn/*",
    "https://luogu.com.cn/*",
    "https://login.luogu.com.cn/*",
    "https://qoj.ac/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action":{"default_title":"ToBe 浏览器连接","default_popup":"connection.html"},
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://www.codeforces.com/*",
        "https://atcoder.jp/*",
        "https://ac.nowcoder.com/*",
        "https://www.nowcoder.com/*",
        "https://nowcoder.com/*",
        "https://www.luogu.com.cn/*",
        "https://luogu.com.cn/*",
        "https://login.luogu.com.cn/*",
        "https://qoj.ac/*"
      ],
      "js": [
        "identity.js",
        "official.js",
        "reading.js",
        "virtual.js",
        "main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*",
        "https://www.codeforces.com/*",
        "https://atcoder.jp/*",
        "https://ac.nowcoder.com/*",
        "https://www.nowcoder.com/*",
        "https://nowcoder.com/*",
        "https://www.luogu.com.cn/*",
        "https://luogu.com.cn/*",
        "https://login.luogu.com.cn/*",
        "https://qoj.ac/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
