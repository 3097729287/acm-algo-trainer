{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tobe.local/schemas/ipc-v1.json",
  "title": "ToBe IPC protocol version 1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "method", "path"],
      "properties": {
        "version": {"const": 1},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "method": {"enum": ["GET", "POST"]},
        "path": {"type": "string", "maxLength": 256, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"},
        "query": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}}},
        "body": {"type": "object"},
        "token": {"type": "string"},
        "owner": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"method": {"const": "GET"}}}, "then": {"not": {"required": ["body"]}}},
        {"if": {"properties": {"method": {"const": "POST"}}}, "then": {"required": ["body"]}}
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "status", "message", "retryable", "uncertain"],
      "properties": {"code": {"type": "string"}, "status": {"type": "integer", "minimum": 400, "maximum": 599}, "message": {"type": "string"}, "retryable": {"type": "boolean"}, "uncertain": {"type": "boolean"}}
    },
    "response": {
      "type": "object",
      "required": ["version", "id", "ok", "meta"],
      "properties": {
        "version": {"const": 1}, "id": {"type": "string"}, "ok": {"type": "boolean"},
        "data": {}, "error": {"$ref": "#/$defs/error"},
        "meta": {"type": "object", "required": ["elapsedMicros", "backend"], "properties": {"elapsedMicros": {"type": "integer", "minimum": 0}, "backend": {"const": "rust"}}}
      },
      "allOf": [
        {"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["data"], "not": {"required": ["error"]}}},
        {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"], "not": {"required": ["data"]}}}
      ]
    }
  }
}
