{
  default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
      profile shortlived
    }
  }
  @account_state_put {
    method PUT
    path /v1/accounts/state
  }
  handle @account_state_put {
    request_body {
      max_size 4194304
    }
    reverse_proxy api:8080
  }
  handle {
    request_body {
      max_size 65536
    }
    reverse_proxy api:8080
  }
}
