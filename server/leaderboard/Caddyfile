{
  default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
  tls {
    issuer acme {
      dir https://acme-v02.api.letsencrypt.org/directory
      profile shortlived
    }
  }
  # Public release files are copied into the existing Caddy config volume.
  # Serving downloads does not touch the account API, database or its volumes.
  handle_path /updates/* {
    root * /config/tb-updates
    @metadata path /stable/*
    header @metadata Cache-Control "no-cache"
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  # V2 objects and batches remain bounded independently of legacy snapshots.
  @account_chunks path /v2/accounts/state*
  handle @account_chunks {
    request_body {
      max_size 131072
    }
    reverse_proxy api:8080
  }
  @account_state_put {
    method PUT
    path /v1/accounts/state
  }
  handle @account_state_put {
    request_body {
      max_size 4194304
    }
    reverse_proxy api:8080
  }
  handle {
    request_body {
      max_size 65536
    }
    reverse_proxy api:8080
  }
}
