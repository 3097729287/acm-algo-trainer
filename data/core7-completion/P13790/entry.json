    "default": "## P13790 Border\n\n原题：[P13790](https://www.luogu.com.cn/problem/P13790)\n\n### 思路\n\n长度 n−d 的 border 等价于 s[i]=s[i+d]。一次改字只会影响同余链中至多两条比较边。用正反 Z 找首末失配，再分一条失配与两条相邻失配检查，LCE 核对中间没有其它失配。\n\n以样例 abaa 为例，比较距离为一的字符。两条失配共享 b，且它两边均为 a，因此只改这个共享位置即可得到长度三的 border。\n\n![一次修改修复两条相邻比较](assets/border-one-edit.svg)\n\n### 复杂度\n\n时间 O(n log n)，空间 O(n)。\n\n### 参考代码\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nvector<int> zfunction(const string &s) {\n    int n = s.size();\n    vector<int> z(n);\n    z[0] = n;\n    for (int i = 1, l = 0, r = 0; i < n; i++) {\n        if (i <= r)\n            z[i] = min(r - i + 1, z[i - l]);\n        while (i + z[i] < n && s[z[i]] == s[i + z[i]])\n            z[i]++;\n        if (i + z[i] - 1 > r) {\n            l = i;\n            r = i + z[i] - 1;\n        }\n    }\n    return z;\n}\n\nstruct LCE {\n    int n, size;\n    vector<int> rank, tree;\n    LCE(const string &s) : n(s.size()), rank(n) {\n        vector<int> sa(n), r(n), tmp(n), y(n), count(max(257, n + 1));\n        int classes = 256;\n        for (int i = 0; i < n; i++) {\n            r[i] = (unsigned char)s[i] + 1;\n            count[r[i]]++;\n        }\n        for (int i = 1; i <= classes; i++)\n            count[i] += count[i - 1];\n        for (int i = n - 1; i >= 0; i--)\n            sa[--count[r[i]]] = i;\n        for (int gap = 1; gap < n; gap *= 2) {\n            int z = 0;\n            for (int i = max(0, n - gap); i < n; i++)\n                y[z++] = i;\n            for (int v : sa)\n                if (v >= gap)\n                    y[z++] = v - gap;\n            fill(count.begin(), count.begin() + classes + 1, 0);\n            for (int v : y)\n                count[r[v]]++;\n            for (int i = 1; i <= classes; i++)\n                count[i] += count[i - 1];\n            for (int i = n - 1; i >= 0; i--)\n                sa[--count[r[y[i]]]] = y[i];\n            int nextClasses = 1;\n            tmp[sa[0]] = 1;\n            for (int i = 1; i < n; i++) {\n                int a = sa[i - 1], b = sa[i];\n                if (r[a] != r[b] ||\n                    (a + gap < n ? r[a + gap] : 0) != (b + gap < n ? r[b + gap] : 0))\n                    nextClasses++;\n                tmp[b] = nextClasses;\n            }\n            r.swap(tmp);\n            classes = nextClasses;\n            if (classes == n)\n                break;\n        }\n        for (int i = 0; i < n; i++)\n            rank[sa[i]] = i;\n        vector<int> height(n);\n        for (int i = 0, h = 0; i < n; i++) {\n            int at = rank[i];\n            if (!at) {\n                h = 0;\n                continue;\n            }\n            int j = sa[at - 1];\n            while (i + h < n && j + h < n && s[i + h] == s[j + h])\n                h++;\n            height[at] = h;\n            if (h)\n                h--;\n        }\n        size = 1;\n        while (size < n)\n            size *= 2;\n        tree.assign(2 * size, n);\n        for (int i = 0; i < n; i++)\n            tree[size + i] = height[i];\n        for (int i = size - 1; i; i--)\n            tree[i] = min(tree[i * 2], tree[i * 2 + 1]);\n    }\n    int query(int a, int b) const {\n        if (a == b)\n            return n - a;\n        int l = rank[a], r = rank[b];\n        if (l > r)\n            swap(l, r);\n        int ans = n;\n        for (l += size + 1, r += size + 1; l < r; l /= 2, r /= 2) {\n            if (l & 1)\n                ans = min(ans, tree[l++]);\n            if (r & 1)\n                ans = min(ans, tree[--r]);\n        }\n        return ans;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    cin >> s;\n    int n = s.size();\n    auto z = zfunction(s);\n    string reverseS = s;\n    reverse(reverseS.begin(), reverseS.end());\n    auto rz = zfunction(reverseS);\n    unique_ptr<LCE> lce;\n    for (int d = 1; d < n; d++) {\n        int length = n - d, l = z[d];\n        bool ok = false;\n        if (l >= length)\n            ok = true;\n        else {\n            int r = length - 1 - rz[d];\n            if (l == r)\n                ok = l < d || l + 2 * d >= n;\n            else if (r == l + d && s[l] == s[l + 2 * d]) {\n                if (d == 1)\n                    ok = true;\n                else {\n                    if (!lce)\n                        lce = make_unique<LCE>(s);\n                    ok = lce->query(l + 1, l + d + 1) >= d - 1;\n                }\n            }\n        }\n        if (ok) {\n            cout << n - d << '\\n';\n            return 0;\n        }\n    }\n    cout << 0 << '\\n';\n\n    return 0;\n}\n```\n\n### 实现提醒\n\n一次改字最多影响两条比较；一条失配必须有可改链端；border 必须短于原串。\n",
    "detailed": "## P13790 Border\n\n原题：[P13790](https://www.luogu.com.cn/problem/P13790)\n\n### 从问题到算法\n\n固定移位 d，把位置按模 d 分成若干链，每条边比较相距 d 的字符。改一个字符只影响它左右两条链边。因此所有失配必须集中在一条边，或两条拥有同一个中间顶点的相邻边。\n\n正向 Z[d] 给首失配 l，反串 Z[d] 给末失配 r。无失配则原本成立。只有一条失配 l=r 时，必须修改链的端点才能不破坏其它相等边，也就是 l<d 或 l+2d≥n。\n\n有两条时，必须 r=l+d，且两外端字符 s[l]、s[l+2d] 相同，才能把中间改成它们。还要确认首末之间其它比较都相等，即 LCE(l+1,l+d+1)≥d−1。首末之外已由正反 Z 保证。\n\nLCE 使用后缀数组、相邻 LCP 与区间最小值树，完全确定性，不依赖哈希。按 d 从小到大检查，首个成功对应最大真 border；没有成功则零。\n\n以样例 abaa 为例，比较距离为一的字符。两条失配共享 b，且它两边均为 a，因此只改这个共享位置即可得到长度三的 border。\n\n![一次修改修复两条相邻比较](assets/border-one-edit.svg)\n\n### 复杂度\n\n时间 O(n log n)，空间 O(n)。\n\n### 参考代码\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nvector<int> zfunction(const string &s) {\n    int n = s.size();\n    vector<int> z(n);\n    z[0] = n;\n    for (int i = 1, l = 0, r = 0; i < n; i++) {\n        if (i <= r)\n            z[i] = min(r - i + 1, z[i - l]);\n        while (i + z[i] < n && s[z[i]] == s[i + z[i]])\n            z[i]++;\n        if (i + z[i] - 1 > r) {\n            l = i;\n            r = i + z[i] - 1;\n        }\n    }\n    return z;\n}\n\nstruct LCE {\n    int n, size;\n    vector<int> rank, tree;\n    LCE(const string &s) : n(s.size()), rank(n) {\n        vector<int> sa(n), r(n), tmp(n), y(n), count(max(257, n + 1));\n        int classes = 256;\n        for (int i = 0; i < n; i++) {\n            r[i] = (unsigned char)s[i] + 1;\n            count[r[i]]++;\n        }\n        for (int i = 1; i <= classes; i++)\n            count[i] += count[i - 1];\n        for (int i = n - 1; i >= 0; i--)\n            sa[--count[r[i]]] = i;\n        for (int gap = 1; gap < n; gap *= 2) {\n            int z = 0;\n            for (int i = max(0, n - gap); i < n; i++)\n                y[z++] = i;\n            for (int v : sa)\n                if (v >= gap)\n                    y[z++] = v - gap;\n            fill(count.begin(), count.begin() + classes + 1, 0);\n            for (int v : y)\n                count[r[v]]++;\n            for (int i = 1; i <= classes; i++)\n                count[i] += count[i - 1];\n            for (int i = n - 1; i >= 0; i--)\n                sa[--count[r[y[i]]]] = y[i];\n            int nextClasses = 1;\n            tmp[sa[0]] = 1;\n            for (int i = 1; i < n; i++) {\n                int a = sa[i - 1], b = sa[i];\n                if (r[a] != r[b] ||\n                    (a + gap < n ? r[a + gap] : 0) != (b + gap < n ? r[b + gap] : 0))\n                    nextClasses++;\n                tmp[b] = nextClasses;\n            }\n            r.swap(tmp);\n            classes = nextClasses;\n            if (classes == n)\n                break;\n        }\n        for (int i = 0; i < n; i++)\n            rank[sa[i]] = i;\n        vector<int> height(n);\n        for (int i = 0, h = 0; i < n; i++) {\n            int at = rank[i];\n            if (!at) {\n                h = 0;\n                continue;\n            }\n            int j = sa[at - 1];\n            while (i + h < n && j + h < n && s[i + h] == s[j + h])\n                h++;\n            height[at] = h;\n            if (h)\n                h--;\n        }\n        size = 1;\n        while (size < n)\n            size *= 2;\n        tree.assign(2 * size, n);\n        for (int i = 0; i < n; i++)\n            tree[size + i] = height[i];\n        for (int i = size - 1; i; i--)\n            tree[i] = min(tree[i * 2], tree[i * 2 + 1]);\n    }\n    int query(int a, int b) const {\n        if (a == b)\n            return n - a;\n        int l = rank[a], r = rank[b];\n        if (l > r)\n            swap(l, r);\n        int ans = n;\n        for (l += size + 1, r += size + 1; l < r; l /= 2, r /= 2) {\n            if (l & 1)\n                ans = min(ans, tree[l++]);\n            if (r & 1)\n                ans = min(ans, tree[--r]);\n        }\n        return ans;\n    }\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    cin >> s;\n    int n = s.size();\n    auto z = zfunction(s);\n    string reverseS = s;\n    reverse(reverseS.begin(), reverseS.end());\n    auto rz = zfunction(reverseS);\n    unique_ptr<LCE> lce;\n    for (int d = 1; d < n; d++) {\n        int length = n - d, l = z[d];\n        bool ok = false;\n        if (l >= length)\n            ok = true;\n        else {\n            int r = length - 1 - rz[d];\n            if (l == r)\n                ok = l < d || l + 2 * d >= n;\n            else if (r == l + d && s[l] == s[l + 2 * d]) {\n                if (d == 1)\n                    ok = true;\n                else {\n                    if (!lce)\n                        lce = make_unique<LCE>(s);\n                    ok = lce->query(l + 1, l + d + 1) >= d - 1;\n                }\n            }\n        }\n        if (ok) {\n            cout << n - d << '\\n';\n            return 0;\n        }\n    }\n    cout << 0 << '\\n';\n\n    return 0;\n}\n```\n\n### 实现提醒\n\n一次改字最多影响两条比较；一条失配必须有可改链端；border 必须短于原串。\n"
