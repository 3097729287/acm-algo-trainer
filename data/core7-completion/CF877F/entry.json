    "default": "## CF877F Ann and Books\n\n原题：[CF877F](https://www.luogu.com.cn/problem/CF877F)\n\n### 思路\n\n数学书取正值、经济书取负值，子段条件化为前缀差等于 k。莫队维护前缀下标区间 [l−1,r]，左右端加入时分别查询 v+k 与 v−k，保持下标先后关系。\n\n例如数组 [1,−1,2]，前缀为 [0,1,0,2]，k=1。向右加入 2，要找较早的 1；移走最左的 0，要删除它与较晚的 1 的配对。下标先后决定减法方向，不能按无序值对计数。\n\n![莫队的左右端点为什么用不同配对公式](assets/mo-prefix.svg)\n\n### 复杂度\n\n时间 O((n+q)sqrt n+n log n)，空间 O(n+q)。\n\n### 参考代码\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    long long k;\n    cin >> n >> k;\n    vector<int> type(n + 1);\n    for (int i = 1; i <= n; i++)\n        cin >> type[i];\n    vector<long long> p(n + 1), values;\n    for (int i = 1; i <= n; i++) {\n        long long x;\n        cin >> x;\n        p[i] = p[i - 1] + (type[i] == 1 ? x : -x);\n    }\n    for (long long x : p) {\n        values.push_back(x);\n        values.push_back(x - k);\n        values.push_back(x + k);\n    }\n    sort(values.begin(), values.end());\n    values.erase(unique(values.begin(), values.end()), values.end());\n    vector<int> id(n + 1), minus(n + 1), plus(n + 1);\n    for (int i = 0; i <= n; i++) {\n        id[i] = lower_bound(values.begin(), values.end(), p[i]) - values.begin();\n        minus[i] = lower_bound(values.begin(), values.end(), p[i] - k) - values.begin();\n        plus[i] = lower_bound(values.begin(), values.end(), p[i] + k) - values.begin();\n    }\n    int q;\n    cin >> q;\n\n    struct Query {\n        int l, r, id;\n    };\n    vector<Query> queries(q);\n    for (int i = 0; i < q; i++) {\n        cin >> queries[i].l >> queries[i].r;\n        queries[i].id = i;\n    }\n    int block = max(1, (int)sqrt(n));\n    sort(queries.begin(), queries.end(), [&](Query a, Query b) {\n        if (a.l / block != b.l / block)\n            return a.l < b.l;\n        return (a.l / block) & 1 ? a.r > b.r : a.r < b.r;\n    });\n\n    vector<int> freq(values.size());\n    vector<long long> ans(q);\n    long long current = 0;\n    int l = 0, r = -1;\n    auto add = [&](int i, bool left) {\n        current += freq[left ? plus[i] : minus[i]];\n        freq[id[i]]++;\n    };\n    auto remove = [&](int i, bool left) {\n        freq[id[i]]--;\n        current -= freq[left ? plus[i] : minus[i]];\n    };\n    for (auto x : queries) {\n        x.l--;\n        while (l > x.l)\n            add(--l, true);\n        while (r < x.r)\n            add(++r, false);\n        while (l < x.l)\n            remove(l++, true);\n        while (r > x.r)\n            remove(r--, false);\n        ans[x.id] = current;\n    }\n    for (long long x : ans)\n        cout << x << '\\n';\n\n    return 0;\n}\n```\n\n### 实现提醒\n\n左右端配对公式不同；包含 prefix[0]；前缀和与答案均为六十四位。\n",
    "detailed": "## CF877F Ann and Books\n\n原题：[CF877F](https://www.luogu.com.cn/problem/CF877F)\n\n### 从问题到算法\n\n把每本数学书的问题数记为正，经济书记为负。子段 [x,y] 符合条件当且仅当 prefix[y]−prefix[x−1]=k。与异或不同，减法有方向，不能把两个前缀值当作无序配对。\n\n在右端加入值 v，它是较晚的前缀，需要已有较早前缀等于 v−k；在左端加入值 v，它是较早的前缀，需要较晚值等于 v+k。删除时先减少自身频数，再按相同方向减去配对数，以处理 k=0。\n\n前缀和可达十的十四次方，用 long long。把所有前缀及其加减 k 的值统一离散化，提前记录三个索引，端点移动时仅访问数组。每个原子段对应一对不同且有序的前缀下标，既不遗漏也不重复。\n\n例如数组 [1,−1,2]，前缀为 [0,1,0,2]，k=1。向右加入 2，要找较早的 1；移走最左的 0，要删除它与较晚的 1 的配对。下标先后决定减法方向，不能按无序值对计数。\n\n![莫队的左右端点为什么用不同配对公式](assets/mo-prefix.svg)\n\n### 复杂度\n\n时间 O((n+q)sqrt n+n log n)，空间 O(n+q)。\n\n### 参考代码\n\n```cpp\n#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    long long k;\n    cin >> n >> k;\n    vector<int> type(n + 1);\n    for (int i = 1; i <= n; i++)\n        cin >> type[i];\n    vector<long long> p(n + 1), values;\n    for (int i = 1; i <= n; i++) {\n        long long x;\n        cin >> x;\n        p[i] = p[i - 1] + (type[i] == 1 ? x : -x);\n    }\n    for (long long x : p) {\n        values.push_back(x);\n        values.push_back(x - k);\n        values.push_back(x + k);\n    }\n    sort(values.begin(), values.end());\n    values.erase(unique(values.begin(), values.end()), values.end());\n    vector<int> id(n + 1), minus(n + 1), plus(n + 1);\n    for (int i = 0; i <= n; i++) {\n        id[i] = lower_bound(values.begin(), values.end(), p[i]) - values.begin();\n        minus[i] = lower_bound(values.begin(), values.end(), p[i] - k) - values.begin();\n        plus[i] = lower_bound(values.begin(), values.end(), p[i] + k) - values.begin();\n    }\n    int q;\n    cin >> q;\n\n    struct Query {\n        int l, r, id;\n    };\n    vector<Query> queries(q);\n    for (int i = 0; i < q; i++) {\n        cin >> queries[i].l >> queries[i].r;\n        queries[i].id = i;\n    }\n    int block = max(1, (int)sqrt(n));\n    sort(queries.begin(), queries.end(), [&](Query a, Query b) {\n        if (a.l / block != b.l / block)\n            return a.l < b.l;\n        return (a.l / block) & 1 ? a.r > b.r : a.r < b.r;\n    });\n\n    vector<int> freq(values.size());\n    vector<long long> ans(q);\n    long long current = 0;\n    int l = 0, r = -1;\n    auto add = [&](int i, bool left) {\n        current += freq[left ? plus[i] : minus[i]];\n        freq[id[i]]++;\n    };\n    auto remove = [&](int i, bool left) {\n        freq[id[i]]--;\n        current -= freq[left ? plus[i] : minus[i]];\n    };\n    for (auto x : queries) {\n        x.l--;\n        while (l > x.l)\n            add(--l, true);\n        while (r < x.r)\n            add(++r, false);\n        while (l < x.l)\n            remove(l++, true);\n        while (r > x.r)\n            remove(r--, false);\n        ans[x.id] = current;\n    }\n    for (long long x : ans)\n        cout << x << '\\n';\n\n    return 0;\n}\n```\n\n### 实现提醒\n\n左右端配对公式不同；包含 prefix[0]；前缀和与答案均为六十四位。\n"
