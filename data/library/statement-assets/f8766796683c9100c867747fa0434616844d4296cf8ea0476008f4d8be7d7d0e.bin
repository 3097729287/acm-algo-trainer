<svg xmlns="http://www.w3.org/2000/svg" width="360" height="140" viewBox="0 0 360 140" role="img">
<title>按原题文字重绘的前序编号完全二叉树</title>
<desc>1-2; 1-3</desc>
<rect width="360" height="140" rx="8" fill="#f6f8fa"/>
<path d="M180 35 L95 105" stroke="#40505b" stroke-width="2.5"/>
<path d="M180 35 L265 105" stroke="#40505b" stroke-width="2.5"/>
<circle cx="180" cy="35" r="19" fill="#fff" stroke="#40505b" stroke-width="2"/>
<text x="180" y="41" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#17232d">1</text>
<circle cx="95" cy="105" r="19" fill="#fff" stroke="#40505b" stroke-width="2"/>
<text x="95" y="111" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#17232d">2</text>
<circle cx="265" cy="105" r="19" fill="#fff" stroke="#40505b" stroke-width="2"/>
<text x="265" y="111" text-anchor="middle" font-family="sans-serif" font-size="18" fill="#17232d">3</text>
</svg>