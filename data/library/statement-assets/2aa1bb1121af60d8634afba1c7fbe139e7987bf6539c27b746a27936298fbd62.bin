or":{"uid":1024213,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/1024213.png","name":"albertting","slogan":"\u9893\u5e9f\u3002|| \u7edd\u5bf9\u6ca1\u6709\u5728\u8bf4 P-hua\uff01\uff01\uff01 || \u82b8\u85b9\u5c5e\u690d\u7269\u4e00\u682a","badge":null,"isAdmin":false,"isBanned":false,"color":"Red","ccfLevel":7,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/d47rymq6.png"},"time":1765718730}],"locale":"zh-CN","canEdit":false},"user":null,"time":1794173989.252116}