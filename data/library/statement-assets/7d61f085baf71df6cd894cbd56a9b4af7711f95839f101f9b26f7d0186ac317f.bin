ceptSolution":false,"acceptLanguages":[5,1,2,28,3,4,11,12,27,34,7,25,8,33,15,14,19,30,31,32,21,22,17,9,16,13,23],"samples":[["4\n1 2 3 4","0.33"],["4\n1 2 3 9","2.00"],["2\n1 2","0.00"]],"limits":{"time":[1000,1000,1000,1000,1000,1000,1000,1000,1000,1000],"memory":[128000,128000,128000,128000,128000,128000,128000,128000,128000,128000]}},"translations":{"en":{"name":"Facer\u0027s Magic","background":"Facer accidentally trespassed into a forbidden land and learned magic.","description":"After entering the forbidden land, Facer meets an opponent.\n\nMore specifically, Facer\u0027s magic is a sequence of numbers.\n\nHowever, Facer\u0027s ability is limited: this sequence can only be chosen from the given $n$ numbers, and the magic value produced equals the average of the chosen numbers.\n\nHis opponent does not wield magic as powerful as Facer\u0027s, but he can counter: he takes the median of the numbers Facer chose; that is his magic value.\n\nFind the maximum amount by which Facer can counter the opponent\u0027s magic.\n\nIn one sentence: given $n$ numbers, you may choose any non-empty subset so that (average \u2212 median) is maximized.\n\nDefinition of median: for a multiset of size $k$, sort the chosen numbers in non-decreasing order. If $k$ is odd, the median is the middle element; if $k$ is even, the median is the average of the two middle elements.","formatI":"The first line contains a positive integer $n$.\n\nThe second line contains $n$ numbers as described.","formatO":"Output the maximum value of (average \u2212 median) that Facer can achieve, to two decimal places.","hint":"Constraints:\n- For $20\\%$ of the testdata, $n \\leq 100$.\n- For $50\\%$ of the testdata, $n \\leq 2000$.\n- For $100\\%$ of the testdata, $n \\leq 10^5$, $0 \\leq x_i \\leq 10^6$.\n\nTranslated by ChatGPT 5","locale":"en"},"zh-CN":{"name":"Facer\u7684\u9b54\u6cd5","background":"Facer \u8bef\u95ef\u5165\u7981\u5730\uff0c\u5b66\u4f1a\u4e86\u9b54\u6cd5\u3002","description":"Facer \u95ef\