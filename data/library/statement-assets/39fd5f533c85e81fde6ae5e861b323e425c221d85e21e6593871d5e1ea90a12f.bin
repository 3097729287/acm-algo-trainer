6700\u5c0f\u65f6\u9700\u8981\u51c6\u5907\u7684\u8003\u8bd5\u79d1\u76ee\u6570\u91cf $k$ \u548c\u5bf9\u5e94\u7684\u6700\u5c0f\u300c\u538b\u529b\u503c\u300d\u3002\u5982\u679c\u6709\u591a\u4e2a $k$ \u5bf9\u5e94\u7684\u300c\u538b\u529b\u503c\u300d\u76f8\u540c\u4e14\u6700\u5c0f\uff0c\u8bf7\u5728\u76f8\u5e94\u4f4d\u7f6e\u8f93\u51fa\u5176\u4e2d\u6700\u5c0f\u7684\u4e00\u4e2a\u3002","hint":"### \u6570\u636e\u89c4\u6a21\u4e0e\u7ea6\u5b9a\n\n\u5bf9\u4e8e $100\\%$ \u7684\u6570\u636e\uff0c\u4fdd\u8bc1 $0 \\leq n \\leq 10 ^ 6$\uff0c$1 \\leq a _ i \\leq 10 ^ 9$\uff0c$1 \\leq c \\leq 10 ^ 9$\u3002\n\n| \u6d4b\u8bd5\u70b9\u7f16\u53f7 | $n$ | $a _ i$ |\n| :----------: | :----------: | :----------: |\n| $1$ | $= 0$ | $\\leq 10 ^ 9$ |\n| $2$ | $= 1$ | $\\leq 10 ^ 9$ |\n| $3 \\sim 5$ | $\\leq 10$ | $\\leq 10 ^ 9$ |\n| $6$ | $\\leq 10 ^ 6$ | $= 1$ |\n| $7 \\sim 10$ | $\\leq 10 ^ 6$ | $\\leq 10 ^ 9$ |","locale":"zh-CN"}},"bookmarked":false,"contest":null,"contestProblems":null,"contestOrigin":null,"vjudgeUsername":null,"lastLanguage":null,"lastCode":"","lastCodeAt":null,"recommendations":[],"forum":{"name":"B3816 [\u8bed\u8a00\u6708\u8d5b 202308] \u5c0f\u7c89\u5154\u7684\u6302\u79d1\u4e0e\u538b\u529b","type":2,"slug":"B3816","color":"orange-3"},"discussions":[{"id":1124488,"title":"90\u5206\u6c42\u8c03\uff01\uff01\uff01","author":{"uid":1769531,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/1769531.png","name":"zszx135","slogan":"\u51cc\u6668\u306e\u96e8","badge":null,"isAdmin":false,"isBanned":false,"color":"Blue","ccfLevel":0,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/kx2xlvun.png"},"time":1754392889},{"id":1123955,"title":"\u6c42\u52a92\u4e2aWA 3\u4e2aAC 1\u4e2aTLE 4\u4e2aRE\u7b11\u56db\u4e86","author":{"uid":1611693,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/1611693.png","name":"Microsoft_Windows","slogan":"","badge":null,"isAdmin":false,"isBanned":false,"color":"Blue","ccfLevel":0,"xcpcLevel":0,"background":"https:\/\/cdn.luogu