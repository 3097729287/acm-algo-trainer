{"instance":"main","template":"problem.show","status":200,"locale":"zh-CN","data":{"problem":{"pid":"P3362","type":"P","name":"Cool loves shaxian","difficulty":5,"fullScore":100,"tags":[5,33,81,337],"totalSubmit":1286,"totalAccepted":328,"flag":5,"provider":{"uid":829,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/829.png","name":"Scarlet","slogan":"","badge":"\u8299\u5170\u6735\u9732","isAdmin":false,"isBanned":false,"color":"Blue","ccfLevel":0,"xcpcLevel":0,"background":""},"contenu":{"name":"Cool loves shaxian","background":"Cool \u975e\u5e38\u975e\u5e38\u559c\u6b22\u5403\u6c99\u53bf,\u786e\u5207\u5730\u8bf4,\u4ed6\u975e\u5e38\u975e\u5e38\u628a\u5404\u79cd\u65e0\u8f9c\u7fa4\u4f17\u62c9\u5230\u6c99\u53bf\u53bb\u5403\u996d(\u256f\u2035\u25a1\u2032)\u256f(\u253b\u2501\u253b\u3002\u5927\u5bb6\u90fd\u975e\u5e38\u975e\u5e38\u60f3\u77e5\u9053\u6c99\u53bf\u5230\u5e95\u7ed9\u4e86 Cool \u591a\u5c11\u94b1\u5e26\u76d0\u6c99\u53bf\u5c0f\u5403,\u4ee5\u4fbf\u672a\u6765\u5a01\u903c\u5229\u8bf1 Cool \u6765\u8bf7\u5ba2\u5403\u9694\u58c1\u7684 KFC\u3002\u7ecf\u8fc7\u591a\u65b9\u8ffd\u8e2a,\u5927\u5bb6\u53d1\u73b0\u4e86\u5e26\u76d0\u8d39\u53d1\u653e\u7684\u67d0\u4e00\u4e9b\u89c4\u5f8b\u30fe(o\u25d5\u2200\u25d5)\u30ce\u30fe\u3002\n","description":"\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u4ee5\u58d5\u8457\u79f0\u3002\u8fd9\u5bb6\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u65f6\u6709\u4e2a\u6307\u6570 $d$\u3002\u4ed6\u4f1a\u53d1\u653e $n$ \u8f6e\u5e26\u76d0\u8d39\uff0c\u5728\u7b2c $i$ \u8f6e\u4e2d\uff0c\u90fd\u4f1a\u53d1\u653e $f(i) = \\sum_{k|i} k^d (i \\leq n)$ \u8fd9\u4e48\u591a\u7684\u94b1\u3002\n\n\u73b0\u5728\u5927\u5bb6\u6709\u4e86 $Q$ \u4e2a\u95ee\u9898\uff0c\u6bcf\u4e2a\u95ee\u9898\u90fd\u5f62\u5982 Cool \u53c2\u52a0\u4ece\u7b2c $L_i$ \u8f6e\u5230\u7b2c $R_i$ \u8f6e\u7684\u5e26\u76d0\u6d3b\u52a8\uff0c\u5c06\u80fd\u83b7\u5f97\u591a\u5c11\u94b1\u3002\uff08\u4fdd\u8bc1 $1 \\leq L_i \\leq R_i \\leq n$\uff09\n\n\u7531\u4e8e\u5f00\u5728\u5357\u5927\u8857\u7684\u6c99\u53bf\u5c0f\u5403\u4e0d\u662f\u4e00\u822c\u7684\u6709\u94b1\u554a\uff0c\u6240\u4ee5\u5462\uff0c\u6211\u4eec\u8981\u8ba1\u7b97\u7684\u662f Cool \u6536\u5230\u7684\u94b1\u5bf9 $10^ 9 + 7$ \u53d6\u6a21\u5f97\u5230\u7684\u7b54\u6848\u3002\n","formatI":"\u8f93\u5165\u5305\u542b\u82e5\u5e72\u884c\u3002\n\n\u7b2c\u4e00\u884c\uff0c\u4e09\u4e2a\u6574\u6570\uff0c$n, d, Q$\u3002\uff08$n\\leq 10^7$\uff0c$d\\leq 10^{18}$\uff0c$q\\leq 5\\times 10^4$\u3002\n\n\u63a5\u4e0b\u6765\u7684 $Q$ \u884c,\u6bcf\u884c\u4e24\u4e2a\u6574\u6570 $L_i, R_i$\u3002\n","formatO":"\u8f93\u51fa\u5305\u542b $Q$ \u884c\u3002\n\n\u6bcf\u884c\u4e00\u4e2a\u6574\u6570\uff0c\u8868\u793a Cool \u5f97\u5230\u7684\u5e26\u76d0\u8d39\u3002\n","hint":"\u6837\u4f8b $1$\uff1a\n\n$f(4) = 1^2 + 2^2 + 4^2 = 21$\n\n$f(5) =1^2+5^2= 26$\n\n$f(8) + f(9) + f (10) = 85 + 91 + 130= 306$\n\n\u6837\u4f8b $2$\uff1a\n\n\u5c31\u76f8\u5f53\u4e8e\u5728\u6570 $720$ \u7684\u56e0\u6570\u4e2a\u6570\u5462~\n","locale":"zh-CN"},"content":{"name":"Cool loves shaxian","background":"Cool \u975e\u5e38\u975e\u5e38\u559c\u6b22\u5403\u6c99\u53bf,\u786e\u5207\u5730\u8bf4,\u4ed6\u975e\u5e38\u975e\u5e38\u628a\u5404\u79cd\u65e0\u8f9c\u7fa4\u4f17\u62c9\u5230\u6c99\u53bf\u53bb\u5403\u996d(\u256f\u2035\u25a1\u2032)\u256f(\u253b\u2501\u253b\u3002\u5927\u5bb6\u90fd\u975e\u5e38\u975e\u5e38\u60f3\u77e5\u9053\u6c99\u53bf\u5230\u5e95\u7ed9\u4e86 Cool \u591a\u5c11\u94b1\u5e26\u76d0\u6c99\u53bf\u5c0f\u5403,\u4ee5\u4fbf\u672a\u6765\u5a01\u903c\u5229\u8bf1 Cool \u6765\u8bf7\u5ba2\u5403\u9694\u58c1\u7684 KFC\u3002\u7ecf\u8fc7\u591a\u65b9\u8ffd\u8e2a,\u5927\u5bb6\u53d1\u73b0\u4e86\u5e26\u76d0\u8d39\u53d1\u653e\u7684\u67d0\u4e00\u4e9b\u89c4\u5f8b\u30fe(o\u25d5\u2200\u25d5)\u30ce\u30fe\u3002\n","description":"\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u4ee5\u58d5\u8457\u79f0\u3002\u8fd9\u5bb6\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u65f6\u6709\u4e2a\u6307\u6570 $d$\u3002\u4ed6\u4f1a\u53d1\u653e $n$ \u8f6e\u5e26\u76d0\u8d39\uff0c\u5728\u7b2c $i$ \u8f6e\u4e2d\uff0c\u90fd\u4f1a\u53d1\u653e $f(i) = \\sum_{k|i} k^d (i \\leq n)$ \u8fd9\u4e48\u591a\u7684\u94b1\u3002\n\n\u73b0\u5728\u5927\u5bb6\u6709\u4e86 $Q$ \u4e2a\u95ee\u9898\uff0c\u6bcf\u4e2a\u95ee\u9898\u90fd\u5f62\u5982 Cool \u53c2\u52a0\u4ece\u7b2c $L_i$ \u8f6e\u5230\u7b2c $R_i$ \u8f6e\u7684\u5e26\u76d0\u6d3b\u52a8\uff0c\u5c06\u80fd\u83b7\u5f97\u591a\u5c11\u94b1\u3002\uff08\u4fdd\u8bc1 $1 \\leq L_i \\leq R_i \\leq n$\uff09\n\n\u7531\u4e8e\u5f00\u5728\u5357\u5927\u8857\u7684\u6c99\u53bf\u5c0f\u5403\u4e0d\u662f\u4e00\u822c\u7684\u6709\u94b1\u554a\uff0c\u6240\u4ee5\u5462\uff0c\u6211\u4eec\u8981\u8ba1\u7b97\u7684\u662f Cool \u6536\u5230\u7684\u94b1\u5bf9 $10^ 9 + 7$ \u53d6\u6a21\u5f97\u5230\u7684\u7b54\u6848\u3002\n","formatI":"\u8f93\u5165\u5305\u542b\u82e5\u5e72\u884c\u3002\n\n\u7b2c\u4e00\u884c\uff0c\u4e09\u4e2a\u6574\u6570\uff0c$n, d, Q$\u3002\uff08$n\\leq 10^7$\uff0c$d\\leq 10^{18}$\uff0c$q\\leq 5\\times 10^4$\u3002\n\n\u63a5\u4e0b\u6765\u7684 $Q$ \u884c,\u6bcf\u884c\u4e24\u4e2a\u6574\u6570 $L_i, R_i$\u3002\n","formatO":"\u8f93\u51fa\u5305\u542b $Q$ \u884c\u3002\n\n\u6bcf\u884c\u4e00\u4e2a\u6574\u6570\uff0c\u8868\u793a Cool \u5f97\u5230\u7684\u5e26\u76d0\u8d39\u3002\n","hint":"\u6837\u4f8b $1$\uff1a\n\n$f(4) = 1^2 + 2^2 + 4^2 = 21$\n\n$f(5) =1^2+5^2= 26$\n\n$f(8) + f(9) + f (10) = 85 + 91 + 130= 306$\n\n\u6837\u4f8b $2$\uff1a\n\n\u5c31\u76f8\u5f53\u4e8e\u5728\u6570 $720$ \u7684\u56e0\u6570\u4e2a\u6570\u5462~\n","locale":"zh-CN"},"attachments":[],"showScore":true,"acceptSolution":true,"acceptLanguages":[5,1,2,28,3,4,11,12,27,34,7,25,8,33,15,14,19,30,31,32,21,22,17,9,16,13,23],"samples":[["10 2 2\n4 5\n8 10","47\n306"],["1000 0 1\n720 720","30"]],"limits":{"time":[1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1000],"memory":[256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000,256000]}},"translations":{"en":{"name":"Cool loves shaxian","background":"Cool really, really loves eating at Shaxian. To be precise, he really, really likes dragging all kinds of unsuspecting folks to Shaxian for meals (\u256f\u2035\u25a1\u2032)\u256f(\u253b\u2501\u253b. Everyone is dying to know how much money Shaxian has paid Cool to \u0022endorse\u0022 (d\u00e0iy\u00e1n) Shaxian Snacks, so that in the future they can threaten and cajole Cool into treating them to the KFC next door. After much tracking, people discovered some patterns in how the endorsement fees are paid out \u30fe(o\u25d5\u2200\u25d5)\u30ce\u30fe\u3002","description":"Shaxian is famous for being lavish when paying endorsement (d\u00e0iy\u00e1n) fees. When this Shaxian pays endorsement fees, it uses an exponent $d$. It will pay fees for $n$ rounds. In the $i$-th round, it pays $f(i) = \\sum_{k|i} k^d (i \\leq n)$ money.\n\nNow there are $Q$ queries. Each query asks: if Cool participates from round $L_i$ to round $R_i$, how much money will he receive? (It is guaranteed that $1 \\leq L_i \\leq R_i \\leq n$.)\n\nSince the Shaxian Snacks on South Street is insanely rich, we need to compute the answer modulo $10^ 9 + 7$.","formatI":"The input contains multiple lines.\n\nThe first line contains three integers, $n, d, Q$ ($n\\leq 10^7$, $d\\leq 10^{18}$, $Q\\leq 5\\times 10^4$).\n\nThe next $Q$ lines each contain two integers $L_i, R_i$.","formatO":"The output contains $Q$ lines.\n\nEach line contains one integer, the amount of endorsement fee Cool receives.","hint":"Sample 1:\n\n$f(4) = 1^2 + 2^2 + 4^2 = 21$.\n\n$f(5) =1^2+5^2= 26$.\n\n$f(8) + f(9) + f (10) = 85 + 91 + 130= 306$.\n\nSample 2:\n\nThis is essentially the number of divisors of the number $720$~.\n\nTranslated by ChatGPT 5","locale":"en"},"zh-CN":{"name":"Cool loves shaxian","background":"Cool \u975e\u5e38\u975e\u5e38\u559c\u6b22\u5403\u6c99\u53bf,\u786e\u5207\u5730\u8bf4,\u4ed6\u975e\u5e38\u975e\u5e38\u628a\u5404\u79cd\u65e0\u8f9c\u7fa4\u4f17\u62c9\u5230\u6c99\u53bf\u53bb\u5403\u996d(\u256f\u2035\u25a1\u2032)\u256f(\u253b\u2501\u253b\u3002\u5927\u5bb6\u90fd\u975e\u5e38\u975e\u5e38\u60f3\u77e5\u9053\u6c99\u53bf\u5230\u5e95\u7ed9\u4e86 Cool \u591a\u5c11\u94b1\u5e26\u76d0\u6c99\u53bf\u5c0f\u5403,\u4ee5\u4fbf\u672a\u6765\u5a01\u903c\u5229\u8bf1 Cool \u6765\u8bf7\u5ba2\u5403\u9694\u58c1\u7684 KFC\u3002\u7ecf\u8fc7\u591a\u65b9\u8ffd\u8e2a,\u5927\u5bb6\u53d1\u73b0\u4e86\u5e26\u76d0\u8d39\u53d1\u653e\u7684\u67d0\u4e00\u4e9b\u89c4\u5f8b\u30fe(o\u25d5\u2200\u25d5)\u30ce\u30fe\u3002\n","description":"\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u4ee5\u58d5\u8457\u79f0\u3002\u8fd9\u5bb6\u6c99\u53bf\u53d1\u653e\u5e26\u76d0\u8d39\u65f6\u6709\u4e2a\u6307\u6570 $d$\u3002\u4ed6\u4f1a\u53d1\u653e $n$ \u8f6e\u5e26\u76d0\u8d39\uff0c\u5728\u7b2c $i$ \u8f6e\u4e2d\uff0c\u90fd\u4f1a\u53d1\u653e $f(i) = \\sum_{k|i} k^d (i \\leq n)$ \u8fd9\u4e48\u591a\u7684\u94b1\u3002\n\n\u73b0\u5728\u5927\u5bb6\u6709\u4e86 $Q$ \u4e2a\u95ee\u9898\uff0c\u6bcf\u4e2a\u95ee\u9898\u90fd\u5f62\u5982 Cool \u53c2\u52a0\u4ece\u7b2c $L_i$ \u8f6e\u5230\u7b2c $R_i$ \u8f6e\u7684\u5e26\u76d0\u6d3b\u52a8\uff0c\u5c06\u80fd\u83b7\u5f97\u591a\u5c11\u94b1\u3002\uff08\u4fdd\u8bc1 $1 \\leq L_i \\leq R_i \\leq n$\uff09\n\n\u7531\u4e8e\u5f00\u5728\u5357\u5927\u8857\u7684\u6c99\u53bf\u5c0f\u5403\u4e0d\u662f\u4e00\u822c\u7684\u6709\u94b1\u554a\uff0c\u6240\u4ee5\u5462\uff0c\u6211\u4eec\u8981\u8ba1\u7b97\u7684\u662f Cool \u6536\u5230\u7684\u94b1\u5bf9 $10^ 9 + 7$ \u53d6\u6a21\u5f97\u5230\u7684\u7b54\u6848\u3002\n","formatI":"\u8f93\u5165\u5305\u542b\u82e5\u5e72\u884c\u3002\n\n\u7b2c\u4e00\u884c\uff0c\u4e09\u4e2a\u6574\u6570\uff0c$n, d, Q$\u3002\uff08$n\\leq 10^7$\uff0c$d\\leq 10^{18}$\uff0c$q\\leq 5\\times 10^4$\u3002\n\n\u63a5\u4e0b\u6765\u7684 $Q$ \u884c,\u6bcf\u884c\u4e24\u4e2a\u6574\u6570 $L_i, R_i$\u3002\n","formatO":"\u8f93\u51fa\u5305\u542b $Q$ \u884c\u3002\n\n\u6bcf\u884c\u4e00\u4e2a\u6574\u6570\uff0c\u8868\u793a Cool \u5f97\u5230\u7684\u5e26\u76d0\u8d39\u3002\n","hint":"\u6837\u4f8b $1$\uff1a\n\n$f(4) = 1^2 + 2^2 + 4^2 = 21$\n\n$f(5) =1^2+5^2= 26$\n\n$f(8) + f(9) + f (10) = 85 + 91 + 130= 306$\n\n\u6837\u4f8b $2$\uff1a\n\n\u5c31\u76f8\u5f53\u4e8e\u5728\u6570 $720$ \u7684\u56e0\u6570\u4e2a\u6570\u5462~\n","locale":"zh-CN"}},"bookmarked":false,"contest":null,"contestProblems":null,"contestOrigin":{"id":782,"startTime":1470871800,"endTime":1470920400,"name":"\u3010LGR-024\u3011\u6d1b\u8c37\u516b\u6708\u6708\u8d5bRound1\u66a8Cool\u0027s life \u6b22\u4e50\u8d5b"},"vjudgeUsername":null,"lastLanguage":null,"lastCode":"","lastCodeAt":null,"recommendations":[{"pid":"P3363","type":"P","name":"Cool loves jiaoyi","difficulty":7,"fullScore":100},{"pid":"P3364","type":"P","name":"Cool loves touli","difficulty":7,"fullScore":100},{"pid":"P3237","type":"P","name":"[HNOI2014] \u7c73\u7279\u8fd0\u8f93","difficulty":6,"fullScore":100},{"pid":"P3988","type":"P","name":"[SHOI2013] \u53d1\u724c","difficulty":4,"fullScore":100},{"pid":"P4123","type":"P","name":"[CQOI2016] \u4e0d\u540c\u7684\u6700\u5c0f\u5272","difficulty":7,"fullScore":100}],"forum":{"name":"P3362 Cool loves shaxian","type":2,"slug":"P3362","color":"orange-3"},"discussions":[{"id":1347846,"title":"\u8b66\u793a\u540e\u4eba\uff08if you 85pts WA #3,4,5\uff09","author":{"uid":1335850,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/1335850.png","name":"Yanghao114514","slogan":"\u5495\u503c\u4e0d\u4e0a200\u4e0d\u6539\u7b7e|man|\u67e5\u770b\u4e2a\u4eba\u4e3b\u9875\u53ea\u9700\u8981\u628a.com.cn\u6539\u6210.me\u55b5","badge":null,"isAdmin":false,"isBanned":false,"color":"Orange","ccfLevel":0,"xcpcLevel":0,"background":"https:\/\/cdn.luogu.com.cn\/upload\/image_hosting\/oovtq6xm.png"},"time":1786243637},{"id":1286657,"title":"\u8b66\u793a\u540e\u4eba","author":{"uid":938773,"avatar":"https:\/\/cdn.luogu.com.cn\/upload\/usericon\/938773.png","name":"fangjianan","slogan":"\u6b63\u5982 A+B Problem \u4e2d\u6240\u8bf4\u7684\uff1a\u201c\u4efb\u4f55\u4e00\u4e2a\u4f1f\u5927\u7684\u601d\u60f3\uff0c\u90fd\u6709\u4e00\u4e2a\u5fae\u4e0d\u8db3\u9053\u7684\u5f00\u59cb\u